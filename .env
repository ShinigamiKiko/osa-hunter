# ── OSA Hunter — Configuration ────────────────────────────────
# Скопируй этот файл и заполни значения перед запуском.
#
# SESSION_SECRET — ОБЯЗАТЕЛЬНО.
# Без него приложение не запустится.
# Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   или: openssl rand -hex 32
#
SESSION_SECRET=2a645bd7897b2743311b2c6bd03acbd6933cec7be440ac9f845e58652fd9510d

# NVD API key для CVSS-обогащения (опционально, но рекомендуется).
# Получить: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=dd26b0fa-628e-4209-a4cb-8a1f942bf7fc

# Порты (опционально, дефолты: 3000 / 3001)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# PostgreSQL (опционально, но смени дефолтные пароли перед деплоем)
PGDATABASE=osa
PGUSER=osa
PGPASSWORD=

# GitHub token для activity-сканирования (опционально, увеличивает rate limit)
GITHUB_TOKEN=

OSA_POLICY_FILE=./policy.yaml
# Verdict cache TTL in hours (default 6). Short TTL = new CVEs on an already-
# scanned version are caught on the next scan. Per-CVE CVSS/PoC is cached
# permanently in the DB, so re-scans stay fast regardless. 0 = keep verdicts
# forever (clear manually via DELETE /api/cache).
SCAN_CACHE_TTL_HOURS=6
CVE_CACHE_TTL_HOURS=24

# ── Enrichment feed toggles ───────────────────────────────────
# Turn a feed off (=false) when it is unreachable or unwanted. A disabled feed
# is skipped entirely (no fetch, no timeout) and its data stays empty, which
# simply means rules referencing it won't fire.
#   OSV is the core CVE source and is always on.
OSA_KEV_ENABLED=true      # CISA KEV        (rules: kev)
OSA_EPSS_ENABLED=true     # EPSS/first.org  (rules: epssMax)
OSA_POC_ENABLED=false     # PoC-in-GitHub   (raw.githubusercontent.com — off: unreachable, 8s/CVE)
OSA_TOXIC_ENABLED=false   # toxic-repos     (raw.githubusercontent.com — off: unreachable)
# NVD (CVSS) has no on/off flag; leaving NVD_API_KEY empty just slows it down.

# Nexus gateway. OSA must be reachable before Nexus: client -> OSA -> Nexus.
NEXUS_UPSTREAM=http://nexus:8081
OSA_NEXUS_STRICT=true
OSA_NEXUS_REPOSITORIES={"npm-proxy":"npm","pypi-proxy":"PyPI","maven-public":"Maven","debian-bookworm":{"ecosystem":"Debian:12"},"ubuntu-2204":{"ecosystem":"Ubuntu:22.04","upstream":"https://archive.ubuntu.com/ubuntu","direct":true},"ubuntu-2404":{"ecosystem":"Ubuntu:24.04","upstream":"https://archive.ubuntu.com/ubuntu","direct":true},"alpine-v320":{"ecosystem":"Alpine:v3.20","upstream":"https://dl-cdn.alpinelinux.org/alpine/v3.20","direct":true},"go-proxy":{"ecosystem":"Go","upstream":"https://proxy.golang.org","direct":true},"nuget-proxy":{"ecosystem":"NuGet","upstream":"https://api.nuget.org/v3","downloadUpstream":"https://api.nuget.org/v3-flatcontainer","direct":true},"cargo-proxy":{"ecosystem":"crates.io","upstream":"https://index.crates.io","downloadUpstream":"https://static.crates.io/crates","direct":true},"rubygems-proxy":{"ecosystem":"RubyGems","upstream":"https://rubygems.org","direct":true},"composer":{"ecosystem":"Packagist","upstream":"https://repo.packagist.org","direct":true},"rocky9-baseos":{"ecosystem":"Rocky Linux:9","upstream":"https://mirror.math.princeton.edu/pub/rocky/9/BaseOS/x86_64/os","direct":true},"rocky9-appstream":{"ecosystem":"Rocky Linux:9","upstream":"https://mirror.math.princeton.edu/pub/rocky/9/AppStream/x86_64/os","direct":true},"centos-stream9-baseos":{"ecosystem":"CentOS:9","upstream":"https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os","direct":true},"centos-stream9-appstream":{"ecosystem":"CentOS:9","upstream":"https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os","direct":true},"rhel9-baseos":{"ecosystem":"Red Hat:9"},"rhel9-appstream":{"ecosystem":"Red Hat:9"}}
