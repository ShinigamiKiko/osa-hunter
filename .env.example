SESSION_SECRET=replace-with-a-random-64-character-secret
NVD_API_KEY=
PGDATABASE=osa
PGUSER=osa
PGPASSWORD=replace-with-a-strong-password
ADMIN_PASSWORD=replace-before-first-start
FRONTEND_PORT=3000
BACKEND_PORT=3001
OSA_POLICY_FILE=./policy.yaml
SCAN_CACHE_TTL_HOURS=6
CVE_CACHE_TTL_HOURS=24
OSA_KEV_ENABLED=true
OSA_EPSS_ENABLED=true
OSA_POC_ENABLED=false
OSA_TOXIC_ENABLED=false
# Where the gate fetches from for repositories that do not set their own
# upstream. Use the Nexus host's address when it runs on another machine:
#   NEXUS_UPSTREAM=http://10.0.0.12:8081
NEXUS_UPSTREAM=http://nexus:8081
# Sent verbatim as the Authorization header. Required unless anonymous
# read access is enabled in Nexus:
#   NEXUS_AUTH=Basic $(printf 'admin:PASSWORD' | base64)
# NEXUS_AUTH=
OSA_NEXUS_STRICT=true
OSA_NEXUS_REPOSITORIES={}
SESSION_COOKIE_SECURE=false
HTTPS=false
METRICS_PORT=9100
HTTP_TIMEOUT_MS=12000
HTTP_CONCURRENCY=10
TRIVY_CONCURRENCY=1
TRIVY_QUEUE_SIZE=4
GRYPE_CONCURRENCY=1
GRYPE_QUEUE_SIZE=4
PROXY_RETENTION_DAYS=30
