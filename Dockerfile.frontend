# ── Stage 1: compile SCSS ──────────────────────────────────────
FROM node:22-slim AS scss-build

WORKDIR /scss

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=build_ca \
    if [ -s /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    npm ci --ignore-scripts

# Copy only what's needed for compilation
COPY frontend/public/css ./css

# Compile SCSS → main.css (compressed, no source maps in prod)
RUN npx sass css/scss/main.scss css/main.css --style=compressed --no-source-map

# ── Stage 2: serve with nginx ──────────────────────────────────
FROM nginx:alpine

# Copy everything else (html, js, assets)
COPY frontend/public /usr/share/nginx/html

# Copy compiled CSS last so the checked-in stylesheet cannot overwrite it.
COPY --from=scss-build /scss/css/main.css /usr/share/nginx/html/css/main.css

# A restricted checkout can have 0600 files; nginx workers must read public assets.
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} +

# nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
